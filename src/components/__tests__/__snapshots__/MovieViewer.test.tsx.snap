// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MovieViewer > Snapshot Tests > should render MovieViewer with multiple movies 1`] = `
<section
  aria-label="Movie Viewer"
  class="movie-viewer"
>
  <section
    class="dropdown-container"
  >
    <div
      style="position: relative; width: 100%;"
    >
      <form
        class="search-bar"
      >
        <input
          class="input-field"
          placeholder="Search for movies..."
          type="search"
          value=""
        />
      </form>
      <section
        class="suggestion-container"
      />
    </div>
    <button
      class="dropdown-button"
    >
      Filter
    </button>
  </section>
  <main
    class="movie-display"
  >
    <article
      class="movie-card movie-card--large"
    >
      <figure
        class="image-container"
      >
        <img
          alt="Third Movie poster"
          class="image"
          loading="lazy"
          src="mocked-image-url"
        />
        <button
          aria-label="Add to favorites: Third Movie"
          class="favorite-btn "
          title="Add to favorites"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-heart"
            fill="none"
            height="20"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"
            />
          </svg>
        </button>
      </figure>
      <section
        class="movie-content"
      >
        <header
          class="header"
        >
          <h2
            class="title"
          >
            Third Movie
          </h2>
          <aside
            class="meta"
          >
            <time
              class="year"
              datetime="2023-10-01"
            >
              2023
            </time>
            <span
              class="rating"
            >
              ★ 
              9.1
              /10
            </span>
          </aside>
        </header>
        <section
          class="overview-container"
        >
          <p
            class="overview "
          >
            Third movie description
          </p>
        </section>
      </section>
    </article>
  </main>
  <aside
    class="movie-jump-controls"
  >
    <label
      class="jump-label"
      for="movie-select"
    >
      Go to movie
    </label>
    <select
      aria-label="Select movie to view. 3 movies available"
      class="movie-select"
      id="movie-select"
    >
      <option
        value="0"
      >
        1
        . 
        Third Movie
      </option>
      <option
        value="1"
      >
        2
        . 
        First Movie
      </option>
      <option
        value="2"
      >
        3
        . 
        Second Movie
      </option>
    </select>
  </aside>
  <aside
    class="keyboard-hint"
  >
    <p>
      Use ← → arrow keys to navigate
    </p>
  </aside>
  <nav
    aria-label="Movie navigation"
    class="movie-nav-controls"
    id="movie-navigation"
  >
    <button
      aria-label="Go to previous movie: Second Movie. Currently viewing Third Movie"
      class="nav-btn nav-btn--prev"
    >
      ← Prev
    </button>
    <aside
      class="movie-position"
    >
      <span
        class="position-text"
      >
        1
         of 
        3
      </span>
    </aside>
    <button
      aria-label="Go to next movie: First Movie. Currently viewing Third Movie"
      class="nav-btn nav-btn--next"
    >
      Next →
    </button>
  </nav>
  <div
    aria-atomic="true"
    aria-live="assertive"
    class="sr-only"
  />
</section>
`;

exports[`MovieViewer > Snapshot Tests > should render MovieViewer with no movies 1`] = `
<section
  aria-label="Movie Viewer"
  class="movie-viewer"
>
  <section
    class="dropdown-container"
  >
    <div
      style="position: relative; width: 100%;"
    >
      <form
        class="search-bar"
      >
        <input
          class="input-field"
          placeholder="Search for movies..."
          type="search"
          value=""
        />
      </form>
      <section
        class="suggestion-container"
      />
    </div>
    <button
      class="dropdown-button"
    >
      Filter
    </button>
  </section>
  <p
    class="no-movies"
  >
    No movies available
  </p>
  <div
    aria-atomic="true"
    aria-live="assertive"
    class="sr-only"
  />
</section>
`;

exports[`MovieViewer > Snapshot Tests > should render MovieViewer with single movie 1`] = `
<section
