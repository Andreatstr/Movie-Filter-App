  >
    <button
      aria-label="Go to previous movie: First Movie. Currently viewing First Movie"
      class="nav-btn nav-btn--prev"
      disabled=""
    >
      ← Prev
    </button>
    <aside
      class="movie-position"
    >
      <span
        class="position-text"
      >
        1
